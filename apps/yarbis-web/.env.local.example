# Anthropic API
ANTHROPIC_API_KEY=your_api_key_here

# Deepgram API (for voice transcription)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Google APIs
GOOGLE_DRIVE_API_KEY=your_google_drive_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Slack Integration
SLACK_BOT_TOKEN=your_slack_bot_token
SLACK_SIGNING_SECRET=your_slack_signing_secret

# WhatsApp Cloud API (bot de asistencia)
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_VERIFY_TOKEN=any_random_string_you_choose
# Modelo de Claude para frases libres del bot (sin él, solo funcionan los comandos)
ANTHROPIC_ATTENDANCE_MODEL=your_claude_model_id

# Supabase (base de datos de asistencia). La service role key es solo del servidor.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Clave para el alta de profesores en /api/staff
ADMIN_API_KEY=your_admin_key

# Acceso al tablero y al dashboard (usuario y contraseña)
DASHBOARD_USER=your_user
DASHBOARD_PASSWORD=your_password

# Minutos de tolerancia antes de marcar tardanza
STAFF_LATE_TOLERANCE_MINUTES=10

# App Configuration
NEXT_PUBLIC_CLAUDE_API_BASE=http://localhost:3000
NODE_ENV=development
